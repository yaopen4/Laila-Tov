// firestore.rules

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserRole() {
      return request.auth.token.role;
    }
    
    function getOrganizationId() {
      return request.auth.token.organizationId;
    }
    
    function isAdmin() {
      return getUserRole() == 'admin';
    }
    
    function isCoach() {
      return getUserRole() == 'coach';
    }
    
    function isParent() {
      return getUserRole() == 'parent';
    }
    
    function isSameOrganization(resourceData) {
      return resourceData.organizationId == getOrganizationId();
    }
    
    // INVITATIONS COLLECTION
    match /invitations/{invitationId} {
      // Allow reading invitation by code (for acceptance flow)
      allow read: if isAuthenticated() && 
        (resource.data.invitationCode == request.auth.token.invitationCode ||
         resource.data.createdBy == request.auth.uid ||
         isAdmin());
      
      // Allow creating invitations
      allow create: if isAuthenticated() && 
        (isAdmin() || (isCoach() && request.resource.data.role == 'parent')) &&
        isSameOrganization(request.resource.data) &&
        request.resource.data.createdBy == request.auth.uid;
      
      // Allow updating invitation status
      allow update: if isAuthenticated() && 
        (resource.data.createdBy == request.auth.uid || 
         isAdmin() ||
         (resource.data.email == request.auth.token.email && 
          request.resource.data.status == 'accepted'));
      
      // Prevent deletion, only allow status updates
      allow delete: if false;
    }
    
    // USERS COLLECTION
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isAuthenticated() && 
        (request.auth.uid == userId || 
         isAdmin() ||
         (isCoach() && isSameOrganization(resource.data)));
      
      // Users can update their own profile (limited fields)
      allow update: if isAuthenticated() && 
        request.auth.uid == userId &&
        // Prevent role/organization changes by regular users
        request.resource.data.role == resource.data.role &&
        request.resource.data.organizationId == resource.data.organizationId;
      
      // Only system can create user records (through Cloud Functions)
      allow create: if false;
      
      // Prevent deletion
      allow delete: if false;
    }
    
    // BABY_PROFILES COLLECTION
    match /baby_profiles/{babyId} {
      // Coaches can read profiles they manage
      // Parents can read profiles they have access to
      allow read: if isAuthenticated() && 
        isSameOrganization(resource.data) &&
        (isAdmin() ||
         (isCoach() && resource.data.assignedCoachId == request.auth.uid) ||
         (isParent() && request.auth.uid in resource.data.parentIds));
      
      // Only coaches can create baby profiles
      allow create: if isAuthenticated() && 
        isCoach() &&
        isSameOrganization(request.resource.data) &&
        request.resource.data.assignedCoachId == request.auth.uid &&
        request.resource.data.createdBy == request.auth.uid;
      
      // Coaches can update profiles they manage
      allow update: if isAuthenticated() && 
        isSameOrganization(resource.data) &&
        (isAdmin() ||
         (isCoach() && resource.data.assignedCoachId == request.auth.uid));
      
      // Prevent deletion, only allow archiving
      allow delete: if false;
    }
    
    // ORGANIZATIONS COLLECTION
    match /organizations/{orgId} {
      // Users can read their own organization
      allow read: if isAuthenticated() && 
        getOrganizationId() == orgId;
      
      // Only admins can update organization settings
      allow update: if isAuthenticated() && 
        isAdmin() &&
        getOrganizationId() == orgId;
      
      // Only system can create organizations
      allow create: if false;
      allow delete: if false;
    }
    
    // SLEEP_LOGS COLLECTION
    match /sleep_logs/{logId} {
      // Parents can read/write their baby's sleep logs
      // Coaches can read sleep logs for babies they manage
      allow read, write: if isAuthenticated() && 
        exists(/databases/$(database)/documents/baby_profiles/$(resource.data.babyProfileId)) &&
        (isAdmin() ||
         (isCoach() && 
          get(/databases/$(database)/documents/baby_profiles/$(resource.data.babyProfileId)).data.assignedCoachId == request.auth.uid) ||
         (isParent() && 
          request.auth.uid in get(/databases/$(database)/documents/baby_profiles/$(resource.data.babyProfileId)).data.parentIds));
    }
    
    // INVITATION_TEMPLATES COLLECTION
    match /invitation_templates/{templateId} {
      allow read: if isAuthenticated() && 
        isSameOrganization(resource.data);
      
      allow create, update, delete: if isAuthenticated() && 
        isAdmin() &&
        isSameOrganization(resource.data);
    }
  }
}