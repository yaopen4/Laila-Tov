# ---------------------------------------------------------------------------
# Laila Tov — environment configuration
#
# Copy to .env.local:   cp .env.example .env.local
#
# The defaults below run the whole app against the local Firebase Emulator
# Suite: free, offline, and no Firebase project or credentials required.
#   npm run emulators   (terminal 1)
#   npm run seed        (once, to create demo data)
#   npm run dev         (terminal 2)
# ---------------------------------------------------------------------------

# --- Emulator mode ---------------------------------------------------------
# Set to 'false' and fill in the real values below to use a live Firebase project.
NEXT_PUBLIC_USE_EMULATORS=true

# Client SDK -> emulators
NEXT_PUBLIC_AUTH_EMULATOR_HOST=localhost:9099
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=localhost:8080

# Admin SDK -> emulators. The Admin SDK reads these two automatically; their
# presence is what tells the server code no real credentials are needed.
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
FIRESTORE_EMULATOR_HOST=localhost:8080

# --- Firebase project ------------------------------------------------------
# In emulator mode the project ID must match the one the emulator runs under
# (npm run emulators uses demo-laila-tov). The "demo-" prefix is what tells
# Firebase tooling this is a fake project that must never be contacted for real.
# For production, change it to your real project ID.
# A web API key is NOT a secret (it identifies the project, it does not
# authenticate), so these are safe to commit in a real deployment.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-laila-tov
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=laila-tov.firebaseapp.com
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=laila-tov.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=948624363951
NEXT_PUBLIC_FIREBASE_APP_ID=1:948624363951:web:4ebb4d39ffebf8315b5f5a

# --- Server-side secrets ---------------------------------------------------
# REQUIRED IN PRODUCTION, unused in emulator mode.
#
# The service-account JSON, on ONE line. This IS a secret: it grants full
# admin access to your Firebase project. Never commit it.
# Get it from: Firebase Console > Project settings > Service accounts >
#              Generate new private key
# FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}

# Guards the one-time first-admin bootstrap endpoint (POST /api/admin/bootstrap).
# Without an admin, no invitations can be created and nobody can sign up — this
# is how you create the first one. Use a long random string; rotate after use.
ADMIN_BOOTSTRAP_SECRET=change-me-to-a-long-random-string

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:9002
