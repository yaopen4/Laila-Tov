
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to get the user's role from the 'users' collection
    function getUserRole(userId) {
      let userDocPath = /databases/$(database)/documents/users/$(userId);
      // Check if the user document exists
      if (exists(userDocPath)) {
        let userData = get(userDocPath).data;
        // Check if the 'role' key exists in the user's data
        if (userData.keys().has('role')) {
          return userData.role;
        }
      }
      // Return null if user document or role doesn't exist
      return null;
    }

    // Rules for the 'users' collection (user profiles)
    match /users/{userId} {
      // Admin can do anything to user profiles
      allow read, write, delete: if request.auth != null && getUserRole(request.auth.uid) == 'admin';

      // Users can read and update their own profile
      // Coaches can read parent profiles linked to them via 'coachId' on the parent's user doc
      allow read: if request.auth != null && (
                    request.auth.uid == userId ||
                    (getUserRole(request.auth.uid) == 'coach' && resource.data.coachId == request.auth.uid)
                  );
      allow update: if request.auth != null && request.auth.uid == userId;

      // Users can create their own profile document (e.g., on first sign-up)
      allow create: if request.auth != null && request.auth.uid == userId;
    }

    // Rules for the 'coaches' collection (coach-specific profiles)
    match /coaches/{coachId} {
      // Admin can do anything to coach profiles
      allow read, write, delete: if request.auth != null && getUserRole(request.auth.uid) == 'admin';

      // Coaches can read and update their own coach profile
      allow read, update: if request.auth != null && request.auth.uid == coachId;
      // Coaches can create their own coach profile if their role is 'coach'
      allow create: if request.auth != null && request.auth.uid == coachId && getUserRole(request.auth.uid) == 'coach';
    }

    // Rules for the 'invites' collection
    match /invites/{inviteCode} {
      // Admin can do anything to invites
      allow read, write, delete: if request.auth != null && getUserRole(request.auth.uid) == 'admin';

      // Coaches can read and update invites they created
      // Parents can read an invite if their email is listed (for redeeming)
      allow read: if request.auth != null && (
                    (resource.data.coachId == request.auth.uid && getUserRole(request.auth.uid) == 'coach') ||
                    (request.auth.token.email in resource.data.parentEmails && getUserRole(request.auth.uid) == 'parent')
                  );
      // Coaches can create invites
      allow create: if request.auth != null &&
                       request.resource.data.coachId == request.auth.uid &&
                       getUserRole(request.auth.uid) == 'coach';
      // Coaches can update their own invites
      // Parents can update invites to redeem them (e.g., change status, add to usedBy)
      allow update: if request.auth != null && (
                      (resource.data.coachId == request.auth.uid && getUserRole(request.auth.uid) == 'coach') ||
                      (
                        getUserRole(request.auth.uid) == 'parent' &&
                        request.auth.token.email in resource.data.parentEmails &&
                        (request.resource.data.status != resource.data.status || request.auth.uid in request.resource.data.usedBy)
                      )
                    );
    }

    // Rules for the 'babies' collection
    match /babies/{babyId} {
      // Admin can do anything to baby documents
      allow read, write, delete: if request.auth != null && getUserRole(request.auth.uid) == 'admin';

      // Coaches can read, write, and delete babies assigned to them
      allow read, write, delete: if request.auth != null &&
                                    resource.data.coachId == request.auth.uid &&
                                    getUserRole(request.auth.uid) == 'coach';
      // Parents can read and write data for their linked baby
      allow read, write: if request.auth != null &&
                            request.auth.uid in resource.data.parentIds &&
                            getUserRole(request.auth.uid) == 'parent';

      // Creation of baby documents is usually tied to invite redemption or direct coach action.
      // This rule allows a coach to create if they set themselves as coachId,
      // or allows creation if a parentId is being set (part of invite flow).
      allow create: if request.auth != null && (
                      (request.resource.data.coachId == request.auth.uid && getUserRole(request.auth.uid) == 'coach') ||
                      (request.auth.uid in request.resource.data.parentIds && getUserRole(request.auth.uid) == 'parent')
                    );

      // Rules for the 'sleepRecords' subcollection (nested under babies)
      match /sleepRecords/{recordId} {
        // Admin has full access via the parent baby document rule
        allow read, write, delete: if request.auth != null && getUserRole(request.auth.uid) == 'admin';

        // Coach can CRUD sleep records for babies they coach
        allow read, write, delete: if request.auth != null &&
                                      get(/databases/$(database)/documents/babies/$(babyId)).data.coachId == request.auth.uid &&
                                      getUserRole(request.auth.uid) == 'coach';
        // Parents can CRUD sleep records for their baby
        allow read, write: if request.auth != null &&
                              request.auth.uid in get(/databases/$(database)/documents/babies/$(babyId)).data.parentIds &&
                              getUserRole(request.auth.uid) == 'parent';
      }
    }
  }
}
