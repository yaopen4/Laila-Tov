
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============== HELPER FUNCTIONS ============== //

    /**
     * Checks if the user is authenticated.
     */
    function isAuthenticated() {
      return request.auth != null;
    }

    /**
     * Retrieves the role of a specified user from the 'users' collection.
     * @param userId The UID of the user.
     * @return The user's role (e.g., 'admin', 'coach', 'parent').
     */
    function getRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }
    
    /**
     * Checks if the user document exists.
     * @param userId The UID of the user.
     * @return True if the user document exists.
     */
    function userExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }
    
    /**
     * Checks if the requesting user has a specific role.
     * @param role The role to check for (e.g., 'admin').
     * @return True if the user has the specified role.
     */
    function isRole(role) {
      return isAuthenticated() && getRole(request.auth.uid) == role;
    }

    /**
     * Checks if the requesting user is the owner of the document.
     * @param userId The UID to match against the request's auth UID.
     * @return True if the UIDs match.
     */
    function isUser(userId) {
        return isAuthenticated() && request.auth.uid == userId;
    }


    // ============== COLLECTION RULES ============== //

    // USERS
    // Defines access rules for user profile documents.
    match /users/{userId} {
      // Users can read/update their own profile. Admins can read/update any user (checked in app logic).
      allow read, update: if isUser(userId) || (userExists(request.auth.uid) && isRole('admin'));
      
      // User creation rules - simplified to avoid chicken-and-egg problems
      allow create: if isAuthenticated() && (
        // Any authenticated user can create their own user document during registration
        isUser(userId) ||
        // Allow placeholder users to be created (for invitation system)
        userId.matches('placeholder_.*')
      );
      
      // Deletion requires admin role (checked safely only if user doc exists)
      allow delete: if userExists(request.auth.uid) && isRole('admin');
    }

    // INVITES
    // Defines who can create, read, and use invitations.
    match /invites/{inviteId} {
      // Invites can be read by any authenticated user to check validity.
      // Assumes frontend handles anonymous sign-in for new users.
      allow read: if isAuthenticated();
      // Admins and coaches can create new invites.
      // Using direct check instead of isRole function to avoid potential issues
      allow create: if isAuthenticated() && 
                       exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                       (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
                        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach');
      // Allow updates for:
      // 1. Parents redeeming invites (usedBy and status fields only)
      // 2. Admins managing invites (all fields for revocation, etc.)
      allow update: if isAuthenticated() && (
        // Parents can update usedBy and status during redemption
        request.resource.data.diff(resource.data).changedKeys().hasOnly(['usedBy', 'status']) ||
        // Admins can update any field for invite management (using direct check like create rule)
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
      // Only admins can delete invites (using direct check for consistency)
      allow delete: if isAuthenticated() && 
                       exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                       get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // BABIES
    // Defines access rules for baby profiles and their subcollections.
    match /babies/{babyId} {
      // A baby profile can be created by coaches or admins.
      // Using direct check for consistent permission checking
      allow create: if isAuthenticated() && 
                       exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
                       (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coach' ||
                        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin');
      
      // Admins, the assigned coach, or linked parents can read a baby's profile.
      allow read: if isRole('admin') 
                    || resource.data.coachId == request.auth.uid 
                    || request.auth.uid in resource.data.parentIds;
      
      // Admins or the assigned coach can delete a baby profile.
      allow delete: if isRole('admin') || resource.data.coachId == request.auth.uid;

      // Update rules are split for different roles:
      allow update: if 
        // Rule 1: Admins and the assigned coach can update any field.
        (isRole('admin') || resource.data.coachId == request.auth.uid) ||
        // Rule 2: A parent can ONLY add themselves to the parentIds list.
        (
          isAuthenticated() &&
          // The user's ID must be in the new list of parents.
          request.auth.uid in request.resource.data.parentIds &&
          // The new list must be exactly one longer than the old list.
          request.resource.data.parentIds.size() == resource.data.parentIds.size() + 1 &&
          // The 'parentIds' field must be the ONLY field being changed.
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parentIds'])
        );
      
      // SLEEPRECORDS Subcollection
      // Defines access for sleep data within a baby's profile.
      match /sleepRecords/{recordId} {
        // Admins, the coach, or parents can read, create, and update sleep records.
        allow read, create, update: if isRole('admin')
                                    || get(/databases/$(database)/documents/babies/$(babyId)).data.coachId == request.auth.uid
                                    || request.auth.uid in get(/databases/$(database)/documents/babies/$(babyId)).data.parentIds;
        
        // Admins, the coach, or parents can delete sleep records.
        allow delete: if isRole('admin')
                      || get(/databases/$(database)/documents/babies/$(babyId)).data.coachId == request.auth.uid
                      || request.auth.uid in get(/databases/$(database)/documents/babies/$(babyId)).data.parentIds;
      }
    }

    // COACHES
    // Defines access rules for coach profile documents.
    match /coaches/{coachId} {
      // A coach can read and update their own profile. Admins can read any coach profile.
      allow read: if isUser(coachId) || (userExists(request.auth.uid) && isRole('admin'));
      // A coach can create their own profile document during registration.
      allow create: if isUser(coachId);
      // A coach can update their own profile. Admins can update any coach profile.
      allow update: if isUser(coachId) || (userExists(request.auth.uid) && isRole('admin'));
      // Only admins can delete coach profiles.
      allow delete: if userExists(request.auth.uid) && isRole('admin');
    }

    // LOGS
    // Defines access rules for application logs.
    match /logs/{logId} {
      // Only the system can create logs (authenticated users with valid sessions)
      allow create: if isAuthenticated();
      // Only admins can read logs
      allow read: if isRole('admin');
      // No updates or deletes allowed for logs (immutable)
      allow update, delete: if false;
    }

    // AUDIT LOGS
    // Defines access rules for audit trail logs.
    match /auditLogs/{auditLogId} {
      // Only the system can create audit logs (authenticated users with valid sessions)
      allow create: if isAuthenticated();
      // Only admins can read audit logs
      allow read: if isRole('admin');
      // No updates or deletes allowed for audit logs (immutable)
      allow update, delete: if false;
    }
  }
}
