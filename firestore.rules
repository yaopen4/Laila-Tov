
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check user role
    // Assumes a 'users' collection where each document has a 'role' field.
    function getUserRole(userId) {
      let userDoc = get(/databases/$(database)/documents/users/$(userId));
      if (exists(/databases/$(database)/documents/users/$(userId))) {
        return userDoc.data.role;
      }
      return null; // Or handle as 'guest' or default if preferred
    }

    // Users Collection: Stores basic user info and roles
    match /users/{userId} {
      allow read: if request.auth != null && (
                    request.auth.uid == userId ||  // User can read their own document
                    getUserRole(request.auth.uid) == 'admin' || // Admin can read any user document
                    (getUserRole(request.auth.uid) == 'coach' && resource.data.coachId == request.auth.uid) // Coach can read parent user they invited/are linked to
                  );
      allow create: if request.auth != null && request.auth.uid == userId; // Any authenticated user can create their own user document on signup
      allow update: if request.auth != null && (
                    request.auth.uid == userId || // User can update their own document
                    getUserRole(request.auth.uid) == 'admin' // Admin can update any user document
                  );
      allow delete: if request.auth != null && getUserRole(request.auth.uid) == 'admin'; // Only admin can delete user documents
    }

    // Coaches Collection: Specific profiles for users with the 'coach' role
    match /coaches/{coachId} { // coachId here is the same as the user's UID
      allow read: if request.auth != null && (
                    request.auth.uid == coachId || // Coach can read their own profile
                    getUserRole(request.auth.uid) == 'admin' // Admin can read any coach profile
                  );
      allow create: if request.auth != null &&
                     request.auth.uid == coachId && // Must be creating their own coach profile
                     getUserRole(request.auth.uid) == 'coach'; // User must have 'coach' role
      allow update: if request.auth != null && (
                    (request.auth.uid == coachId && getUserRole(request.auth.uid) == 'coach') || // Coach can update their own profile
                    getUserRole(request.auth.uid) == 'admin' // Admin can update any coach profile
                  );
      allow delete: if request.auth != null && getUserRole(request.auth.uid) == 'admin'; // Only admin can delete coach profiles
    }

    // Invites Collection: Manages invitation codes for parents
    match /invites/{inviteCode} {
      allow read: if request.auth != null && (
                    resource.data.coachId == request.auth.uid || // Coach who created the invite can read it
                    request.auth.token.email in resource.data.parentEmails || // Parent whose email is on invite can read it (for redemption)
                    getUserRole(request.auth.uid) == 'admin' // Admin can read any invite
                  );
      allow create: if request.auth != null &&
                     request.resource.data.coachId == request.auth.uid && // coachId in the new invite must match creator's UID
                     getUserRole(request.auth.uid) == 'coach'; // Only a coach can create invites
      allow update: if request.auth != null && (
                    (resource.data.coachId == request.auth.uid && getUserRole(request.auth.uid) == 'coach') || // Coach can update their own invite
                    (request.auth.token.email in resource.data.parentEmails && // Parent redeeming invite
                     (request.resource.data.status != resource.data.status || request.auth.uid in request.resource.data.usedBy) // e.g. changing status or adding to usedBy
                    ) ||
                    getUserRole(request.auth.uid) == 'admin' // Admin can update any invite
                  );
      allow delete: if request.auth != null && getUserRole(request.auth.uid) == 'admin'; // Only admin can delete invites
    }

    // Babies Collection: Stores data for each baby
    match /babies/{babyId} {
      allow read: if request.auth != null && (
                    request.auth.uid in resource.data.parentIds || // Parent linked to the baby can read
                    resource.data.coachId == request.auth.uid ||   // Coach assigned to the baby can read
                    getUserRole(request.auth.uid) == 'admin'      // Admin can read any baby
                  );
      // Baby creation typically happens via invite redemption or directly by a coach/admin
      allow create: if request.auth != null && (
                    (request.resource.data.coachId == request.auth.uid && getUserRole(request.auth.uid) == 'coach') || // Coach creating a baby
                    (request.auth.uid in request.resource.data.parentIds && request.resource.data.inviteCode != null) || // Parent creating via invite redemption
                    getUserRole(request.auth.uid) == 'admin' // Admin creating a baby
                  );
      allow update: if request.auth != null && (
                    request.auth.uid in resource.data.parentIds || // Parent can update their baby's data
                    (resource.data.coachId == request.auth.uid && getUserRole(request.auth.uid) == 'coach') || // Coach can update their assigned baby's data
                    getUserRole(request.auth.uid) == 'admin' // Admin can update any baby
                  );
      allow delete: if request.auth != null && (
                    (resource.data.coachId == request.auth.uid && getUserRole(request.auth.uid) == 'coach') || // Coach can delete their assigned baby
                    getUserRole(request.auth.uid) == 'admin' // Admin can delete any baby
                  );

      // SleepRecords Subcollection: Nested under each baby
      match /sleepRecords/{recordId} {
        // Helper to check if the current user has access to the parent baby document
        function hasBabyAccess() {
          let babyDocData = get(/databases/$(database)/documents/babies/$(babyId)).data;
          return request.auth.uid in babyDocData.parentIds ||
                 babyDocData.coachId == request.auth.uid ||
                 getUserRole(request.auth.uid) == 'admin';
        }

        // Allow read and write if user has access to the parent baby document
        allow read, write: if request.auth != null && hasBabyAccess();
      }
    }
  }
}
