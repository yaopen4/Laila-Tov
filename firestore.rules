
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to get user's role from the 'users' collection
    function getUserRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }
    
    // USERS collection: Users can read/update their own document.
    match /users/{userId} {
      allow read, update: if isAuthenticated() && request.auth.uid == userId;
      // Anyone can create their own user document during sign-up
      allow create: if isAuthenticated(); 
    }

    // COACHES collection: Only authenticated users (admins) can manage these.
    // For now, let's allow any authenticated user to read for simplicity.
    match /coaches/{coachId} {
        allow read: if isAuthenticated();
        // In production, write access should be limited to admins
        allow write: if isAuthenticated() && getUserRole(request.auth.uid) == 'admin';
    }

    // INVITES collection:
    // Users need to read an invite before they are authenticated.
    // Once authenticated, they need to write to it to redeem it.
    match /invites/{inviteId} {
      allow read: if true; // Allow reading invites to check them
      allow update: if isAuthenticated(); // Allow authenticated users to redeem
      // Creating invites should be limited to coaches
      allow create: if isAuthenticated() && getUserRole(request.auth.uid) == 'coach';
    }

    // BABIES collection and SLEEPRECORDS subcollection
    match /babies/{babyId} {
      // Allow read if user is the assigned coach OR one of the linked parents.
      allow read: if isAuthenticated() && 
                    (resource.data.coachId == request.auth.uid || request.auth.uid in resource.data.parentIds);
      
      // Allow update if user is the assigned coach.
      allow update: if isAuthenticated() && resource.data.coachId == request.auth.uid;
      
      // A baby document can only be created by a coach.
      allow create: if isAuthenticated() && getUserRole(request.auth.uid) == 'coach';
      
      allow delete: if isAuthenticated() && resource.data.coachId == request.auth.uid;

      // SLEEPRECORDS subcollection
      match /sleepRecords/{recordId} {
        // Allow read/write if user is the coach or a linked parent.
        allow read, write: if isAuthenticated() &&
                            (get(/databases/$(database)/documents/babies/$(babyId)).data.coachId == request.auth.uid ||
                                request.auth.uid in get(/databases/$(database)/documents/babies/$(babyId)).data.parentIds);
      }
    }
  }
}
