rules_version = '2';

// Laila Tov — Firestore security rules
//
// Authorization keys off Firebase Auth CUSTOM CLAIMS (request.auth.token.role and
// .organizationId), set server-side by the Admin SDK during registration.
//
// The previous version resolved role by get()-ing /users/{uid} inside the rules.
// That cost 1-3 document reads on every rule evaluation (against a hard limit of 10)
// and, worse, deadlocked signup: creating your own user document required already
// having a user document that said you were an admin. Claims are present in the token
// before any document exists, which dissolves that cycle.
//
// Privileged writes (creating users, invitations, audit logs) are performed by the
// Admin SDK in Next.js API routes. The Admin SDK bypasses these rules entirely, so
// those paths are simply denied to clients here.

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- helpers ----------

    function isSignedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function role() {
      return request.auth.token.role;
    }

    function org() {
      return request.auth.token.organizationId;
    }

    function isAdmin() {
      return isSignedIn() && role() == 'admin';
    }

    function isCoach() {
      return isSignedIn() && role() == 'coach';
    }

    function isParent() {
      return isSignedIn() && role() == 'parent';
    }

    function isSelf(userId) {
      return isSignedIn() && uid() == userId;
    }

    // Same tenant. Admins are scoped to their own organization too.
    function inOrg(resourceOrg) {
      return isSignedIn() && org() == resourceOrg;
    }

    // True when the incoming write leaves every listed field untouched.
    function keepsFields(fields) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(fields);
    }

    function babyData(babyId) {
      return get(/databases/$(database)/documents/baby_profiles/$(babyId)).data;
    }

    function canReadBaby(baby) {
      return isSignedIn() && (
        (isAdmin() && inOrg(baby.organizationId)) ||
        (isCoach() && baby.assignedCoachId == uid()) ||
        (isParent() && uid() in baby.parentIds)
      );
    }

    // ---------- users ----------
    //
    // Created only by the server (Admin SDK) during invitation redemption, so that
    // role/permissions cannot be self-assigned.

    match /users/{userId} {
      // Evaluated per document, for both get and list: a query that could return
      // someone else's user document simply fails, so no blanket list rule is needed.
      allow read: if isSelf(userId)
                  || ((isAdmin() || isCoach()) && inOrg(resource.data.organizationId));

      allow create: if false; // server only

      // A user may edit their own profile, but never their own authorization.
      // The old rules protected only role/organizationId, leaving `permissions`
      // self-writable — a straightforward privilege-escalation path.
      allow update: if isSelf(userId)
                    && keepsFields([
                         'role', 'organizationId', 'permissions', 'status',
                         'assignedCoachId', 'managedBabyProfiles', 'email'
                       ]);

      allow delete: if false; // server only
    }

    // ---------- organizations ----------

    match /organizations/{orgId} {
      allow read: if isSignedIn() && inOrg(orgId);
      allow write: if false; // server only
    }

    // ---------- roles / role assignments ----------
    //
    // Retained for future custom roles. Not on the authorization path: permission
    // checks use the static role->permission map plus the claims above.

    match /roles/{roleId} {
      allow read: if isSignedIn() && inOrg(resource.data.organizationId);
      allow write: if false; // server only
    }

    match /user_role_assignments/{assignmentId} {
      allow read: if isSignedIn() && (resource.data.userId == uid() || isAdmin());
      allow write: if false; // server only
    }

    // ---------- invitations ----------
    //
    // Created, redeemed and cancelled server-side. Unauthenticated code validation
    // goes through GET /api/invitations/validate: a visitor has no token yet, so it
    // could never read this collection directly.

    match /invitations/{invitationId} {
      allow read: if (isAdmin() && inOrg(resource.data.organizationId))
                  || (isCoach() && resource.data.createdBy == uid());
      allow write: if false; // server only
    }

    // Content only -- no authorization is derived from these, so an admin may edit
    // them directly. Nothing sends email yet; they are stored for when something does.
    match /invitation_templates/{templateId} {
      allow read: if isSignedIn() && inOrg(resource.data.organizationId);
      allow create: if isAdmin() && request.resource.data.organizationId == org();
      allow update, delete: if isAdmin() && inOrg(resource.data.organizationId);
    }

    // ---------- baby profiles ----------

    match /baby_profiles/{babyId} {
      // Applies per document to both get and list. A coach querying
      // where('assignedCoachId','==',uid) succeeds; an unconstrained query over the
      // whole collection fails, because some returned document would not pass.
      allow read: if canReadBaby(resource.data);

      allow create: if isCoach()
                    && request.resource.data.assignedCoachId == uid()
                    && request.resource.data.organizationId == org()
                    && request.resource.data.parentIds is list;

      // Coach/admin may edit the profile. A parent may only touch the activity
      // timestamps, which saving a sleep record updates.
      allow update: if (
                      (
                        (
                          (isAdmin() && inOrg(resource.data.organizationId))
                          || (isCoach() && resource.data.assignedCoachId == uid())
                        )
                        && keepsFields(['organizationId', 'createdBy'])
                      )
                      || (
                        isParent()
                        && uid() in resource.data.parentIds
                        && keepsFields([
                             'organizationId', 'createdBy', 'assignedCoachId',
                             'parentIds', 'status', 'coachNotes', 'inviteCode'
                           ])
                      )
                    );

      allow delete: if isAdmin() && inOrg(resource.data.organizationId);

      // ---------- sleep records ----------
      //
      // Costs one get() of the parent baby document. Unavoidable: the subcollection
      // document carries no ownership fields of its own.

      match /sleep_records/{recordId} {
        allow read, write: if canReadBaby(babyData(babyId));
      }
    }

    // ---------- audit & compliance ----------
    //
    // Written exclusively by the server through the Admin SDK, which bypasses rules.
    // Clients read only; admins only, within their organization.

    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /audit_logs_security/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /audit_logs_compliance/{logId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /compliance_reports/{reportId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ---------- default deny ----------
    // Anything not matched above, including the retired `placeholder_users`,
    // `logs`, `auditLogs`, and the legacy `babies`/`invites`/`coaches` collections.

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
