
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check user role
    // Returns the user's role string if the user document and role field exist, otherwise null.
    function getUserRole(userId) {
      return exists(/databases/$(database)/documents/users/$(userId)) &&
             (get(/databases/$(database)/documents/users/$(userId)).data.role != null)
               ? get(/databases/$(database)/documents/users/$(userId)).data.role
               : null;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if request.auth != null && (
                    request.auth.uid == userId ||
                    getUserRole(request.auth.uid) == 'admin' ||
                    (
                      getUserRole(request.auth.uid) == 'coach' &&
                      resource.data.containsKey('coachId') && // Check if coachId field exists
                      resource.data.coachId == request.auth.uid
                    )
                  );
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && (
                      request.auth.uid == userId ||
                      getUserRole(request.auth.uid) == 'admin'
                    );
      allow delete: if request.auth != null && getUserRole(request.auth.uid) == 'admin';
    }

    // Coaches Collection
    match /coaches/{coachId} {
      allow read: if request.auth != null && (
                    request.auth.uid == coachId ||
                    getUserRole(request.auth.uid) == 'admin'
                  );
      allow create: if request.auth != null &&
                       request.auth.uid == coachId &&
                       getUserRole(request.auth.uid) == 'coach';
      allow update: if request.auth != null && (
                      request.auth.uid == coachId ||
                      getUserRole(request.auth.uid) == 'admin'
                    );
      allow delete: if request.auth != null && getUserRole(request.auth.uid) == 'admin';
    }

    // Invites Collection
    match /invites/{inviteCode} {
      allow read: if request.auth != null && (
                    resource.data.coachId == request.auth.uid ||
                    (resource.data.parentEmails != null && request.auth.token.email in resource.data.parentEmails) ||
                    getUserRole(request.auth.uid) == 'admin'
                  );
      allow create: if request.auth != null &&
                       request.resource.data.coachId == request.auth.uid &&
                       getUserRole(request.auth.uid) == 'coach';
      allow update: if request.auth != null && (
                      (resource.data.coachId == request.auth.uid && getUserRole(request.auth.uid) == 'coach') ||
                      (
                        resource.data.parentEmails != null && request.auth.token.email in resource.data.parentEmails &&
                        (
                          request.resource.data.status != resource.data.status ||
                          (request.resource.data.usedBy != null && request.auth.uid in request.resource.data.usedBy)
                        )
                      ) ||
                      getUserRole(request.auth.uid) == 'admin'
                    );
      allow delete: if request.auth != null && getUserRole(request.auth.uid) == 'admin';
    }

    // Babies Collection
    match /babies/{babyId} {
      allow read: if request.auth != null && (
                    (resource.data.parentIds != null && request.auth.uid in resource.data.parentIds) ||
                    resource.data.coachId == request.auth.uid ||
                    getUserRole(request.auth.uid) == 'admin'
                  );
      allow create: if request.auth != null && (
                      (request.resource.data.coachId == request.auth.uid && getUserRole(request.auth.uid) == 'coach') ||
                      (request.resource.data.parentIds != null && request.auth.uid in request.resource.data.parentIds) ||
                      getUserRole(request.auth.uid) == 'admin'
                    );
      allow update: if request.auth != null && (
                      (resource.data.parentIds != null && request.auth.uid in resource.data.parentIds) ||
                      resource.data.coachId == request.auth.uid ||
                      getUserRole(request.auth.uid) == 'admin'
                    );
      allow delete: if request.auth != null && (
                      resource.data.coachId == request.auth.uid ||
                      getUserRole(request.auth.uid) == 'admin'
                    );

      // SleepRecords Subcollection
      match /sleepRecords/{recordId} {
        allow read, write: if request.auth != null && (
                              (get(/databases/$(database)/documents/babies/$(babyId)).data.parentIds != null &&
                               request.auth.uid in get(/databases/$(database)/documents/babies/$(babyId)).data.parentIds) ||
                              get(/databases/$(database)/documents/babies/$(babyId)).data.coachId == request.auth.uid ||
                              getUserRole(request.auth.uid) == 'admin'
                            );
      }
    }
  }
}
