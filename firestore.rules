rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============== HELPER FUNCTIONS ============== //

    /**
     * Checks if the user is authenticated.
     */
    function isAuthenticated() {
      return request.auth != null;
    }

    /**
     * Retrieves the role of a specified user from the 'users' collection.
     * @param userId The UID of the user.
     * @return The user's role (e.g., 'admin', 'coach', 'parent').
     */
    function getRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }
    
    /**
     * Retrieves the organization ID of a specified user.
     */
    function getUserOrganization(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.organizationId;
    }
    
    /**
     * Checks if the user document exists.
     * @param userId The UID of the user.
     * @return True if the user document exists.
     */
    function userExists(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }
    
    /**
     * Checks if the requesting user has a specific role.
     * @param role The role to check for (e.g., 'admin').
     * @return True if the user has the specified role.
     */
    function isRole(role) {
      return isAuthenticated() && getRole(request.auth.uid) == role;
    }

    /**
     * Checks if the requesting user is the owner of the document.
     * @param userId The UID to match against the request's auth UID.
     * @return True if the UIDs match.
     */
    function isUser(userId) {
        return isAuthenticated() && request.auth.uid == userId;
    }

    /**
     * Checks if users belong to the same organization
     */
    function sameOrganization(userId) {
      return isAuthenticated() && 
             getUserOrganization(request.auth.uid) == getUserOrganization(userId);
    }

    /**
     * Checks if a baby profile is assigned to the current user
     */
    function isBabyAssigned(babyId) {
      let baby = get(/databases/$(database)/documents/baby_profiles/$(babyId)).data;
      return request.auth.uid == baby.assignedCoachId || 
             request.auth.uid in baby.parentIds;
    }

    // ============== COLLECTION RULES ============== //

    // USERS COLLECTION
    match /users/{userId} {
      // Users can read their own profile, coaches can read assigned users, admins can read all
      allow read: if isUser(userId) || 
                     (isRole('coach') && sameOrganization(userId)) ||
                     isRole('admin');
      
      // Users can update their own basic profile, admins can update any user
      allow update: if isUser(userId) && 
                       !('role' in request.resource.data.diff(resource.data).affectedKeys()) &&
                       !('organizationId' in request.resource.data.diff(resource.data).affectedKeys()) ||
                       isRole('admin');
      
      // Only admins can create users (through invitation system)
      allow create: if isRole('admin');
      
      // Only admins can delete users
      allow delete: if isRole('admin');
    }

    // ORGANIZATIONS COLLECTION
    match /organizations/{orgId} {
      // Only organization members can read organization data
      allow read: if isAuthenticated() && getUserOrganization(request.auth.uid) == orgId;
      
      // Only admins can modify organization settings
      allow write: if isRole('admin') && getUserOrganization(request.auth.uid) == orgId;
    }

    // ROLES COLLECTION
    match /roles/{roleId} {
      // Organization members can read roles
      allow read: if isAuthenticated() && 
                     getUserOrganization(request.auth.uid) == resource.data.organizationId;
      
      // Only admins can create/modify custom roles (system roles are protected)
      allow write: if isRole('admin') && 
                      getUserOrganization(request.auth.uid) == resource.data.organizationId &&
                      !resource.data.isSystemRole;
    }

    // USER ROLE ASSIGNMENTS COLLECTION
    match /user_role_assignments/{assignmentId} {
      // Users can read their own assignments, admins can read all in organization
      allow read: if resource.data.userId == request.auth.uid ||
                     (isRole('admin') && 
                      getUserOrganization(request.auth.uid) == resource.data.organizationId);
      
      // Only admins can create/modify role assignments
      allow write: if isRole('admin') && 
                      getUserOrganization(request.auth.uid) == resource.data.organizationId;
    }

    // ENHANCED INVITATIONS COLLECTION
    match /invitations/{invitationId} {
      // Users can read invitations they created or are meant for them
      allow read: if resource.data.createdBy == request.auth.uid ||
                     resource.data.email == request.auth.token.email ||
                     (isRole('admin') && 
                      getUserOrganization(request.auth.uid) == resource.data.organizationId);
      
      // Coaches can create parent invitations, admins can create any invitations
      allow create: if (isRole('coach') && request.resource.data.role == 'parent' &&
                       getUserOrganization(request.auth.uid) == request.resource.data.organizationId) ||
                      (isRole('admin') && 
                       getUserOrganization(request.auth.uid) == request.resource.data.organizationId);
      
      // Users can update invitations they created, or system updates
      allow update: if resource.data.createdBy == request.auth.uid ||
                       isRole('admin');
    }

    // INVITATION TEMPLATES COLLECTION
    match /invitation_templates/{templateId} {
      // Organization members can read templates
      allow read: if isAuthenticated() && 
                     getUserOrganization(request.auth.uid) == resource.data.organizationId;
      
      // Only admins can modify templates
      allow write: if isRole('admin') && 
                      getUserOrganization(request.auth.uid) == resource.data.organizationId;
    }

    // ENHANCED BABY PROFILES COLLECTION  
    match /baby_profiles/{babyId} {
      // Assigned coaches, parents, and admins can read
      allow read: if isBabyAssigned(babyId) ||
                     (isRole('admin') && 
                      getUserOrganization(request.auth.uid) == resource.data.organizationId);
      
      // Assigned coaches can create and update baby profiles
      allow create: if isRole('coach') && 
                       request.resource.data.assignedCoachId == request.auth.uid &&
                       getUserOrganization(request.auth.uid) == request.resource.data.organizationId;
      
      allow update: if (resource.data.assignedCoachId == request.auth.uid && isRole('coach')) ||
                       (request.auth.uid in resource.data.parentIds && isRole('parent')) ||
                       isRole('admin');
      
      // Only admins can delete baby profiles
      allow delete: if isRole('admin');
    }

    // SLEEP RECORDS COLLECTION (subcollection of baby_profiles)
    match /baby_profiles/{babyId}/sleep_records/{recordId} {
      // Same access rules as parent baby profile
      allow read, write: if isBabyAssigned(babyId) ||
                            (isRole('admin') && 
                             getUserOrganization(request.auth.uid) == 
                             get(/databases/$(database)/documents/baby_profiles/$(babyId)).data.organizationId);
    }

    // AUDIT LOGS COLLECTION (restricted access)
    match /audit_logs/{logId} {
      // Only admins and system can read audit logs
      allow read: if isRole('admin') && 
                     getUserOrganization(request.auth.uid) == resource.data.organizationId;
      
      // Only system can write audit logs (via Cloud Functions)
      allow write: if false; // All writes handled by server-side functions
    }

    // SECURITY AUDIT LOGS (highly restricted)
    match /audit_logs_security/{logId} {
      // Only system admins can read security logs
      allow read: if isRole('admin') && resource.data.organizationId == 'system';
      
      // Only system can write security audit logs
      allow write: if false;
    }

    // COMPLIANCE AUDIT LOGS
    match /audit_logs_compliance/{logId} {
      // Only admins can read compliance logs for their organization
      allow read: if isRole('admin') && 
                     getUserOrganization(request.auth.uid) == resource.data.organizationId;
      
      // Only system can write compliance audit logs
      allow write: if false;
    }

    // COMPLIANCE REPORTS COLLECTION
    match /compliance_reports/{reportId} {
      // Only admins can read reports for their organization
      allow read: if isRole('admin') && 
                     getUserOrganization(request.auth.uid) == resource.data.organizationId;
      
      // Only system can create reports
      allow write: if false;
    }

    // LEGACY COLLECTIONS SUPPORT (for backward compatibility during transition)
    
    // Legacy babies collection (will be migrated to baby_profiles)
    match /babies/{babyId} {
      allow read, write: if resource.data.coachId == request.auth.uid ||
                            request.auth.uid in resource.data.parentIds ||
                            isRole('admin');
    }
    
    // Legacy invites collection (will be migrated to invitations)
    match /invites/{inviteId} {
      allow read: if resource.data.coachId == request.auth.uid || isRole('admin');
      allow write: if resource.data.coachId == request.auth.uid || isRole('admin');
    }

    // COACHES COLLECTION (for coach-specific data)
    match /coaches/{coachId} {
      allow read, write: if isUser(coachId) || isRole('admin');
    }

    // Default deny rule for any unmatched paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============== HELPER FUNCTIONS ============== //

    /**
     * Checks if the user is authenticated.
     */
    function isAuthenticated() {
      return request.auth != null;
    }

    /**
     * Retrieves the role of a specified user from the 'users' collection.
     * @param userId The UID of the user.
     * @return The user's role (e.g., 'admin', 'coach', 'parent').
     */
    function getRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }
    
    /**
     * Retrieves the organization ID of a specified user.
     */
    function getUserOrganization(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.organizationId;
