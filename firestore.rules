
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ============== HELPER FUNCTIONS ============== //

    /**
     * Checks if the user is authenticated.
     */
    function isAuthenticated() {
      return request.auth != null;
    }

    /**
     * Retrieves the role of a specified user from the 'users' collection.
     * @param userId The UID of the user.
     * @return The user's role (e.g., 'admin', 'coach', 'parent').
     */
    function getRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }
    
    /**
     * Checks if the requesting user has a specific role.
     * @param role The role to check for (e.g., 'admin').
     * @return True if the user has the specified role.
     */
    function isRole(role) {
      return isAuthenticated() && getRole(request.auth.uid) == role;
    }

    /**
     * Checks if the requesting user is the owner of the document.
     * @param userId The UID to match against the request's auth UID.
     * @return True if the UIDs match.
     */
    function isUser(userId) {
        return isAuthenticated() && request.auth.uid == userId;
    }


    // ============== COLLECTION RULES ============== //

    // USERS
    // Defines access rules for user profile documents.
    match /users/{userId} {
      // Admins can read/update any user. Users can read/update their own profile.
      allow read, update: if isUser(userId) || isRole('admin');
      // Any authenticated session can create a user document (for signup).
      allow create: if isAuthenticated();
      // Only admins can delete users.
      allow delete: if isRole('admin');
    }

    // INVITES
    // Defines who can create, read, and use invitations.
    match /invites/{inviteId} {
      // Invites can be read by any authenticated user to check validity.
      // Assumes frontend handles anonymous sign-in for new users.
      allow read: if isAuthenticated();
      // Admins and coaches can create new invites.
      allow create: if isRole('admin') || isRole('coach');
      // An authenticated user can update an invite to redeem it, but only once.
      // This is also used by a parent to link their account to a baby.
      allow update: if isAuthenticated() && resource.data.redeemed == false;
    }

    // BABIES
    // Defines access rules for baby profiles and their subcollections.
    match /babies/{babyId} {
      // A baby profile can only be created by a coach.
      allow create: if isRole('coach');
      
      // Admins, the assigned coach, or linked parents can read a baby's profile.
      allow read: if isRole('admin') 
                    || resource.data.coachId == request.auth.uid 
                    || request.auth.uid in resource.data.parentIds;
      
      // Admins or the assigned coach can delete a baby profile.
      allow delete: if isRole('admin') || resource.data.coachId == request.auth.uid;

      // Update rules are split for different roles:
      allow update: if 
        // Rule 1: Admins and the assigned coach can update any field.
        (isRole('admin') || resource.data.coachId == request.auth.uid) ||
        // Rule 2: A parent can ONLY add themselves to the parentIds list.
        (
          isAuthenticated() &&
          // The user's ID must be in the new list of parents.
          request.auth.uid in request.resource.data.parentIds &&
          // The new list must be exactly one longer than the old list.
          request.resource.data.parentIds.size() == resource.data.parentIds.size() + 1 &&
          // The 'parentIds' field must be the ONLY field being changed.
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['parentIds'])
        );
      
      // SLEEPRECORDS Subcollection
      // Defines access for sleep data within a baby's profile.
      match /sleepRecords/{recordId} {
        // Admins, the coach, or parents can read, create, and update sleep records.
        allow read, create, update: if isRole('admin')
                                    || get(/databases/$(database)/documents/babies/$(babyId)).data.coachId == request.auth.uid
                                    || request.auth.uid in get(/databases/$(database)/documents/babies/$(babyId)).data.parentIds;
        
        // Admins, the coach, or parents can delete sleep records.
        allow delete: if isRole('admin')
                      || get(/databases/$(database)/documents/babies/$(babyId)).data.coachId == request.auth.uid
                      || request.auth.uid in get(/databases/$(database)/documents/babies/$(babyId)).data.parentIds;
      }
    }
  }
}
